EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://192.168.18.11:5000
EXPO_PUBLIC_APP_DATA_MODE=production
# Optional separate Socket.IO origin; otherwise the REST backend URL is used.
EXPO_PUBLIC_SOCKET_URL=
# Set EXPO_PUBLIC_API_URL to same-origin only when a deployed reverse proxy serves /api, /socket.io and /maps.
# Website-restricted Google Maps JavaScript key. Required for interactive web maps.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Use DEMO_MAP_ID only while prototyping; create your own JavaScript map ID for deployment.
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Application-restricted keys for standalone native builds. Expo Go supplies its own maps setup.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
