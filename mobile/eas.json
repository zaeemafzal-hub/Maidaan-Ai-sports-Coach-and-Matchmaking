{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_DATA_MODE": "production"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_APP_DATA_MODE": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
