BACKEND_PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
NODE_ENV=development
APP_DATA_MODE=development
# Hosting platforms usually provide PORT; BACKEND_PORT remains supported locally.
PORT=5000
# Production: exact comma-separated frontend origins, without trailing slashes. Native requests have no Origin.
ALLOWED_ORIGINS=https://app.example.com
# Pilot default: disable checkout; sandbox is the only other supported scope (no live money).
PAYMENT_MODE=disabled

# AI: Gemini first, then Groq on provider failure. Keys stay on the backend.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Sandbox payments only. Never put these secrets in mobile/.env.
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Public HTTPS backend URL for hosted checkout callbacks/webhooks (no trailing slash).
PAYMENTS_PUBLIC_URL=
# Web app URL reachable from the phone/browser.
PAYMENTS_APP_URL=http://192.168.18.11:8081

# Copy the REST Mobile Account API URL from JazzCash sandbox API Testing.
JAZZCASH_WALLET_URL=

# OpenStreetMap is the default map; an HTTPS tile host can be changed without a mobile rebuild.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
