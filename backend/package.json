{
  "name": "backend",
  "version": "1.0.0",
  "description": "Maidaan Express + Supabase Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copyKnowledge.mjs",
    "start": "node dist/server.js",
    "seed:demo": "tsx scripts/seedDemo.ts",
    "admin:grant": "tsx scripts/grantSuperuser.ts",
    "test:ai": "tsx --test tests/aiProviders.test.ts",
    "test:weather": "tsx --test tests/weatherProviders.test.ts",
    "test:history": "tsx --test tests/assistantHistorySql.test.ts tests/assistantHistoryStore.test.ts",
    "test": "npm run test:ai && npm run test:weather && tsx --test tests/reliability.test.ts tests/authRegistration.test.ts tests/emailSecurity.test.ts tests/venueAdmin.test.ts tests/bookingPolicy.test.ts tests/bookingApi.test.ts tests/bookingSql.test.ts tests/locationProfiles.test.ts && tsx tests/agent.test.ts && tsx tests/multiRoleAuth.test.ts && tsx tests/captainTeam.test.ts && tsx tests/hubOwner.test.ts && tsx tests/adminControl.test.ts && tsx tests/dataIsolation.test.ts && tsx tests/chatRealtime.test.ts && npm run test:f0 && npm run test:history",
    "test:f0": "tsx --test tests/f0.test.ts tests/f0Sql.test.ts",
    "test:security": "tsx --test tests/authRegistration.test.ts tests/emailSecurity.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@sfpy/node-core": "^0.3.5",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
