{
  "name": "maidaan-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "type": "module",
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-nativewind.mjs",
    "test:nativewind": "node --test scripts/nativewind-warning.test.mjs",
    "test:speech": "node --test scripts/speech-recognition.test.mjs",
    "test:auth": "node --test scripts/auth-flow.test.mjs",
    "test:maps": "node --test scripts/maps-bridge.test.mjs",
    "test:cloud": "node --test scripts/cloud-deployment.test.mjs",
    "start": "npm --prefix mobile start",
    "android": "npm --prefix mobile run android",
    "ios": "npm --prefix mobile run ios",
    "web": "npm --prefix mobile run web",
    "dev": "node scripts/dev.js",
    "build": "tsc --noEmit --project mobile/tsconfig.json && npm --prefix backend run build",
    "build:web": "npm --prefix mobile run build:web",
    "lint": "tsc --noEmit --project mobile/tsconfig.json && tsc --noEmit --project backend/tsconfig.json",
    "mobile": "npm --prefix mobile start",
    "backend": "npm --prefix backend run dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
